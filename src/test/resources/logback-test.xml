<?xml version="1.0" encoding="UTF-8"?>
<!--
    테스트용 로깅 설정 (Logback)

    logback-test.xml은 logback.xml보다 먼저 읽히므로, 테스트에서는 main의 logback.xml 대신 이 파일이 적용된다.
    Spring을 띄우는 테스트도 Spring Boot가 이 파일로 Logback을 구성하므로, 실행 순서와 상관없이 같은 설정이 적용된다.
    테스트가 logs/app.log에 기록하지 않도록 콘솔에만 출력한다.
-->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="org.church.steward" level="DEBUG"/>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
