<?xml version="1.0" encoding="UTF-8"?>
<!--
    로깅 설정 (Logback)

    logback-spring.xml이 아니라 logback.xml을 쓴다. logback-spring.xml은 Spring 컨텍스트가 뜰 때에야 적용되지만,
    이 프로그램은 로그인, 최초 실행, 복원, 마이그레이션을 Spring 컨텍스트를 띄우기 전에 하므로
    그 구간의 로그도 파일에 남기려면 Logback이 처음부터 이 파일을 읽어야 한다.
    같은 이유로 Spring Boot의 base.xml, file-appender.xml 등을 include하지 않는다(Spring 속성을 전제로 한다).
-->
<configuration>
    <!-- 로그 파일은 프로그램 폴더(AppHome) 아래의 logs/app.log다. -->
    <define name="LOG_FILE" class="org.church.steward.infrastructure.config.LogFilePropertyDefiner"/>
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- 날짜가 바뀌거나 10MB를 넘으면 교체하고, 10일 치를 보관한다. -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_FILE}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>10</maxHistory>
        </rollingPolicy>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
